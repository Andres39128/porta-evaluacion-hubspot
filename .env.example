# Copiar a .env.local y completar con los valores del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-publicable...
SUPABASE_SERVICE_ROLE_KEY=eyJ...SECRETO-solo-servidor...
# Correo de la cuenta super admin creada en Supabase Auth (Auth > Users)
ADMIN_EMAIL=admin@politecnico.edu.co
